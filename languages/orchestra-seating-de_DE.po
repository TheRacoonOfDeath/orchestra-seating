msgid "Conductor"
msgstr "Dirigent"

#. translators: %s: project name
#: src/Export/SeatingPdf.php:73
#, php-format
msgid "Seating: %s"
msgstr "Sitzplan: %s"

#: src/Export/SeatingPdfController.php:64 src/Ui/SeatingController.php:51
msgid "You are not allowed to do this."
msgstr "Das darfst du nicht."

#: src/Export/SeatingPdfController.php:69 src/Ui/SeatingTab.php:57
msgid "Seating"
msgstr "Sitzplan"

#: src/Plugin.php:123
msgid ""
"Orchestra Seating requires Orchestra Core 0.7, Orchestra Projects 0.14, "
"Orchestra Library and Orchestra Members to be active."
msgstr ""
"Orchestra Seating benötigt Orchestra Core 0.7, Orchestra Projects 0.14, "
"Orchestra Library und Orchestra Members."

#: src/Privacy/PersonalData.php:39 src/Privacy/PersonalData.php:54
#: src/Privacy/PersonalData.php:75
msgid "Orchestra seating"
msgstr "Orchester-Sitzplan"

#: src/Privacy/PersonalData.php:79
msgid "Project"
msgstr "Projekt"

#: src/Privacy/PersonalData.php:82
msgid "Row"
msgstr "Reihe"

#: src/Privacy/PersonalData.php:83 src/Ui/SeatingTab.php:232
msgid "Seat"
msgstr "Platz"

#: src/Seating/SeatingInput.php:48
msgid "Choose a project with a seating."
msgstr "Wähle ein Projekt mit Sitzplan."

#: src/Seating/SeatingInput.php:67
msgid "A seat is outside the grid."
msgstr "Ein Platz liegt außerhalb des Rasters."

#: src/Seating/SeatingInput.php:71
msgid "Two people cannot sit on the same seat."
msgstr "Zwei Personen können nicht auf demselben Platz sitzen."

#: src/Seating/SeatingInput.php:108
msgid "The grid cannot get any larger."
msgstr "Das Raster kann nicht größer werden."

#: src/Seating/SeatingInput.php:111
msgid "The grid needs a seat for everyone."
msgstr "Das Raster braucht einen Platz für alle."

#: src/Seating/SeatingInput.php:117
msgid "Only an empty last row or column can be removed."
msgstr "Nur eine leere letzte Reihe oder Spalte kann entfernt werden."

#: src/Ui/SeatingController.php:54
msgid "The seating of a completed project cannot be changed."
msgstr ""
"Der Sitzplan eines abgeschlossenen Projekts kann nicht geändert werden."

#: src/Ui/SeatingController.php:74
msgid "The seating has been saved."
msgstr "Der Sitzplan wurde gespeichert."

#. translators: %s: project name
#: src/Ui/SeatingController.php:79
#, php-format
msgid "The seating of %s has been imported."
msgstr "Der Sitzplan von %s wurde übernommen."

#: src/Ui/SeatingTab.php:124
msgid "Add pieces to the program to show the voices."
msgstr "Füge dem Programm Stücke hinzu, um die Stimmen anzuzeigen."

#. translators: 1: piece title, 2: its position in the program, 3: number of pieces
#: src/Ui/SeatingTab.php:133
#, php-format
msgid "Voices in %1$s (%2$d of %3$d)"
msgstr "Stimmen in %1$s (%2$d von %3$d)"

#: src/Ui/SeatingTab.php:149
msgid "Previous piece"
msgstr "Vorheriges Stück"

#: src/Ui/SeatingTab.php:152
msgid "Next piece"
msgstr "Nächstes Stück"

#: src/Ui/SeatingTab.php:164
msgid "Download PDF"
msgstr "PDF herunterladen"

#: src/Ui/SeatingTab.php:202
msgid "Seat organizers"
msgstr "Organisatoren setzen"

#. translators: 1: number of seated people, 2: number of people to seat
#: src/Ui/SeatingTab.php:205
#, php-format
msgid "%1$d of %2$d people seated. Conductors are not seated."
msgstr ""
"%1$d von %2$d Personen haben einen Platz. Dirigenten bekommen keinen Platz."

#: src/Ui/SeatingTab.php:211 src/Ui/SeatingTab.php:368
msgid "Not seated"
msgstr "Ohne Platz"

#: src/Ui/SeatingTab.php:216
msgid ""
"Drag people onto the seats or back here. Dropping on a taken seat swaps the "
"two. With the keyboard: Enter picks a person up, the arrow keys choose a "
"seat, Enter places them, Delete unseats them."
msgstr ""
"Ziehe Personen auf die Plätze oder hierher zurück. Auf einem besetzten Platz "
"tauschen die beiden. Mit der Tastatur: Enter nimmt eine Person auf, die "
"Pfeiltasten wählen einen Platz, Enter setzt sie, Entf nimmt ihr den Platz."

#: src/Ui/SeatingTab.php:224
msgid "+ Row"
msgstr "+ Reihe"

#: src/Ui/SeatingTab.php:225
msgid "− Row"
msgstr "− Reihe"

#: src/Ui/SeatingTab.php:226
msgid "+ Column"
msgstr "+ Spalte"

#: src/Ui/SeatingTab.php:227
msgid "− Column"
msgstr "− Spalte"

#: src/Ui/SeatingTab.php:232
msgid "Person"
msgstr "Person"

#: src/Ui/SeatingTab.php:239
msgid "Nobody has accepted yet."
msgstr "Noch niemand hat sich angemeldet."

#: src/Ui/SeatingTab.php:243
msgid "Save seating"
msgstr "Sitzplan speichern"

#: src/Ui/SeatingTab.php:246
msgid "Remove everyone from their seats?"
msgstr "Alle von ihren Plätzen nehmen?"

#: src/Ui/SeatingTab.php:247
msgid "Clear seating"
msgstr "Sitzplan leeren"

#: src/Ui/SeatingTab.php:268
msgid "Seating of another project"
msgstr "Sitzplan eines anderen Projekts"

#: src/Ui/SeatingTab.php:272
msgid ""
"Replace the current seating with the seating of the chosen project? People "
"who take part in both keep their seat, everyone else is not seated."
msgstr ""
"Den aktuellen Sitzplan durch den Sitzplan des gewählten Projekts ersetzen? "
"Wer an beiden teilnimmt, behält seinen Platz, alle anderen bekommen keinen "
"Platz."

#: src/Ui/SeatingTab.php:275
msgid "Import seating"
msgstr "Sitzplan übernehmen"

#. translators: %s: name
#: src/Ui/SeatingTab.php:381
#, php-format
msgid "Seat of %s"
msgstr "Platz von %s"

#. translators: 1: row letter, A at the front, 2: seat number, counted from the left
#: src/Ui/SeatingTab.php:389
#, php-format
msgid "Row %1$s, seat %2$d"
msgstr "Reihe %1$s, Platz %2$d"
