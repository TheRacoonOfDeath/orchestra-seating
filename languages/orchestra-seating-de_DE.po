#, php-format
msgid "Voices in %s"
msgstr "Stimmen in %s"

#: src/Export/SeatingPdf.php:58 src/Ui/SeatingTab.php:241
msgid "Conductor"
msgstr "Dirigent"

#. translators: %s: project name
#: src/Export/SeatingPdf.php:66
#, php-format
msgid "Seating: %s"
msgstr "Sitzplan: %s"

#: src/Export/SeatingPdfController.php:54 src/Ui/SeatingController.php:50
msgid "You are not allowed to do this."
msgstr "Das darfst du nicht."

#: src/Export/SeatingPdfController.php:59 src/Ui/SeatingTab.php:51
msgid "Seating"
msgstr "Sitzplan"

#: src/Plugin.php:123
msgid "Orchestra Seating requires Orchestra Core 0.7, Orchestra Projects 0.14, Orchestra Library and Orchestra Members to be active."
msgstr "Orchestra Seating benötigt Orchestra Core 0.7, Orchestra Projects 0.14, Orchestra Library und Orchestra Members."

#: src/Privacy/PersonalData.php:38 src/Privacy/PersonalData.php:53
#: src/Privacy/PersonalData.php:74
msgid "Orchestra seating"
msgstr "Orchester-Sitzplan"

#: src/Privacy/PersonalData.php:78
msgid "Project"
msgstr "Projekt"

#: src/Privacy/PersonalData.php:81
msgid "Row"
msgstr "Reihe"

#: src/Privacy/PersonalData.php:82 src/Ui/SeatingTab.php:198
msgid "Seat"
msgstr "Platz"

#: src/Seating/SeatingInput.php:52
msgid "A seat is outside the grid."
msgstr "Ein Platz liegt außerhalb des Rasters."

#: src/Seating/SeatingInput.php:56
msgid "Two people cannot sit on the same seat."
msgstr "Zwei Personen können nicht auf demselben Platz sitzen."

#: src/Seating/SeatingInput.php:96
msgid "The grid cannot get any larger."
msgstr "Das Raster kann nicht größer werden."

#: src/Seating/SeatingInput.php:99
msgid "The grid needs a seat for everyone."
msgstr "Das Raster braucht einen Platz für alle."

#: src/Seating/SeatingInput.php:105
msgid "Only an empty last row or column can be removed."
msgstr "Nur eine leere letzte Reihe oder Spalte kann entfernt werden."

#: src/Ui/SeatingController.php:53
msgid "The seating of a completed project cannot be changed."
msgstr "Der Sitzplan eines abgeschlossenen Projekts kann nicht geändert werden."

#: src/Ui/SeatingController.php:71
msgid "The seating has been saved."
msgstr "Der Sitzplan wurde gespeichert."

#: src/Ui/SeatingTab.php:121
msgid "Download PDF"
msgstr "PDF herunterladen"

#: src/Ui/SeatingTab.php:152
msgid "Add pieces to the program to show the voices."
msgstr "Füge dem Programm Stücke hinzu, um die Stimmen anzuzeigen."

#: src/Ui/SeatingTab.php:155
msgid "Voices from"
msgstr "Stimmen aus"

#: src/Ui/SeatingTab.php:169
msgid "Seat organizers"
msgstr "Organisatoren setzen"

#. translators: 1: number of seated people, 2: number of people to seat
#: src/Ui/SeatingTab.php:172
#, php-format
msgid "%1$d of %2$d people seated. Conductors are not seated."
msgstr "%1$d von %2$d Personen haben einen Platz. Dirigenten bekommen keinen Platz."

#: src/Ui/SeatingTab.php:178 src/Ui/SeatingTab.php:258
msgid "Not seated"
msgstr "Ohne Platz"

#: src/Ui/SeatingTab.php:183
msgid "Drag people onto the seats or back here. Dropping on a taken seat swaps the two. With the keyboard: Enter picks a person up, the arrow keys choose a seat, Enter places them, Delete unseats them."
msgstr "Ziehe Personen auf die Plätze oder hierher zurück. Auf einem besetzten Platz tauschen die beiden. Mit der Tastatur: Enter nimmt eine Person auf, die Pfeiltasten wählen einen Platz, Enter setzt sie, Entf nimmt ihr den Platz."

#: src/Ui/SeatingTab.php:190
msgid "+ Row"
msgstr "+ Reihe"

#: src/Ui/SeatingTab.php:191
msgid "+ Column"
msgstr "+ Spalte"

#: src/Ui/SeatingTab.php:192
msgid "− Row"
msgstr "− Reihe"

#: src/Ui/SeatingTab.php:193
msgid "− Column"
msgstr "− Spalte"

#: src/Ui/SeatingTab.php:198
msgid "Person"
msgstr "Person"

#: src/Ui/SeatingTab.php:204
msgid "Nobody has accepted yet."
msgstr "Noch niemand hat zugesagt."

#: src/Ui/SeatingTab.php:208
msgid "Save seating"
msgstr "Sitzplan speichern"

#: src/Ui/SeatingTab.php:211
msgid "Remove everyone from their seats?"
msgstr "Alle von ihren Plätzen nehmen?"

#: src/Ui/SeatingTab.php:212
msgid "Clear seating"
msgstr "Sitzplan leeren"

#. translators: %s: name
#: src/Ui/SeatingTab.php:271
#, php-format
msgid "Seat of %s"
msgstr "Platz von %s"

#. translators: 1: row number, counted from the front, 2: seat number, counted from the left
#: src/Ui/SeatingTab.php:279
#, php-format
msgid "Row %1$d, seat %2$d"
msgstr "Reihe %1$d, Platz %2$d"
