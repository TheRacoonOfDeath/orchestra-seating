#: src/Ui/SeatingTab.php:52
msgid "Seating"
msgstr "Sitzplan"

#: src/Plugin.php:134
msgid "The master seating of all members, which projects start from."
msgstr "Der Stammsitzplan aller Mitglieder, mit dem Projekte beginnen."

#: src/Plugin.php:147
msgid ""
"Orchestra Seating requires Orchestra Core 0.9, Orchestra Projects 0.14, "
"Orchestra Library and Orchestra Members to be active."
msgstr ""
"Orchestra Seating benötigt aktive Plugins Orchestra Core 0.9, Orchestra "
"Projects 0.14, Orchestra Library und Orchestra Members."

#: src/Privacy/PersonalData.php:40 src/Privacy/PersonalData.php:55
#: src/Privacy/PersonalData.php:76
msgid "Orchestra seating"
msgstr "Orchester-Sitzplan"

#: src/Privacy/PersonalData.php:80
msgid "Project"
msgstr "Projekt"

#: src/Privacy/PersonalData.php:82 src/Ui/MasterShortcode.php:49
msgid "Master seating"
msgstr "Stammsitzplan"

#: src/Privacy/PersonalData.php:85
msgid "Row"
msgstr "Reihe"

#: src/Privacy/PersonalData.php:86 src/Ui/SeatingEditor.php:112
msgid "Seat"
msgstr "Platz"

#: src/Seating/SeatingInput.php:65 src/Ui/SeatingTab.php:216
msgid "There is no master seating yet."
msgstr "Es gibt noch keinen Stammsitzplan."

#: src/Seating/SeatingInput.php:69
msgid "Nobody in the master seating takes part."
msgstr "Niemand aus dem Stammsitzplan nimmt teil."

#: src/Seating/SeatingInput.php:87
msgid "A seat is outside the grid."
msgstr "Ein Platz liegt außerhalb des Rasters."

#: src/Seating/SeatingInput.php:91
msgid "Two people cannot sit on the same seat."
msgstr "Zwei Personen können nicht auf demselben Platz sitzen."

#: src/Seating/SeatingInput.php:162 src/Seating/SeatingInput.php:172
msgid "This row or column does not exist."
msgstr "Diese Reihe oder Spalte gibt es nicht."

#: src/Seating/SeatingInput.php:165 src/Seating/SeatingInput.php:204
msgid "The grid cannot get any larger."
msgstr "Das Raster kann nicht größer werden."

#: src/Seating/SeatingInput.php:175
msgid "The last row or column cannot be deleted."
msgstr "Die letzte Reihe oder Spalte kann nicht gelöscht werden."

#: src/Seating/SeatingInput.php:199
msgid "The person cannot be seated there."
msgstr "Die Person kann dort nicht platziert werden."

#: src/Ui/MasterController.php:57
msgid "The master seating has been saved."
msgstr "Der Stammsitzplan wurde gespeichert."

#: src/Ui/MasterShortcode.php:35
msgid "Please log in to see the seating."
msgstr "Bitte melde dich an, um den Sitzplan zu sehen."

#: src/Ui/MasterShortcode.php:38
msgid "You are not allowed to arrange the seating."
msgstr "Du darfst den Sitzplan nicht bearbeiten."

#: src/Ui/MasterShortcode.php:55
msgid ""
"The usual seating of every active member and organizer. In a project, "
"\"Apply master seating\" seats everyone who takes part in their row of the "
"master seating, closed up to the left."
msgstr ""
"Der übliche Sitzplan aller aktiven Mitglieder und Organisatoren. In einem "
"Projekt setzt „Stammsitzplan übernehmen“ alle Teilnehmenden in ihre Reihe "
"aus dem Stammsitzplan, nach links aufgerückt."

#: src/Ui/MasterShortcode.php:64
msgid "There are no active members yet."
msgstr "Es gibt noch keine aktiven Mitglieder."

#: src/Ui/SeatingController.php:56
msgid "The seating of a completed project cannot be changed."
msgstr ""
"Der Sitzplan eines abgeschlossenen Projekts kann nicht geändert werden."

#: src/Ui/SeatingController.php:85
msgid "The voice has been changed."
msgstr "Die Stimme wurde geändert."

#: src/Ui/SeatingController.php:88
msgid "The seating has been saved."
msgstr "Der Sitzplan wurde gespeichert."

#: src/Ui/SeatingController.php:90
msgid "The master seating has been applied."
msgstr "Der Stammsitzplan wurde übernommen."

#. translators: 1: number of seated people, 2: number of people to seat
#: src/Ui/SeatingEditor.php:85
#, php-format
msgid "%1$s of %2$d people seated. Conductors are not seated."
msgstr ""
"%1$s von %2$d Personen haben einen Platz. Dirigenten bekommen keinen Platz."

#: src/Ui/SeatingEditor.php:91 src/Ui/SeatingEditor.php:416
msgid "Not seated"
msgstr "Ohne Platz"

#: src/Ui/SeatingEditor.php:92
msgid "Everyone has a seat."
msgstr "Alle haben einen Platz."

#: src/Ui/SeatingEditor.php:97
msgid ""
"Drag people onto the seats or back here. Dropping on a taken seat swaps the "
"two; dropping on the left or right edge of a seat puts the person between "
"two people, and the others move aside. With the keyboard: Enter picks a "
"person up, the arrow keys choose a seat, Enter places them, Delete unseats "
"them."
msgstr ""
"Ziehe Personen auf die Plätze oder hierher zurück. Auf einem besetzten Platz "
"werden die beiden getauscht; am linken oder rechten Rand eines Platzes kommt "
"die Person zwischen zwei Personen, und die anderen rücken zur Seite. Mit der "
"Tastatur: Enter nimmt eine Person auf, die Pfeiltasten wählen einen Platz, "
"Enter setzt sie ab, Entf nimmt ihr den Platz."

#: src/Ui/SeatingEditor.php:112
msgid "Person"
msgstr "Person"

#: src/Ui/SeatingEditor.php:124
msgid "Save seating"
msgstr "Sitzplan speichern"

#: src/Ui/SeatingEditor.php:132
msgid "Remove everyone from their seats?"
msgstr "Alle von ihren Plätzen nehmen?"

#: src/Ui/SeatingEditor.php:133
msgid "Clear seating"
msgstr "Sitzplan leeren"

#. translators: %d: seat number
#: src/Ui/SeatingEditor.php:177
#, php-format
msgid "Add a column left of seat %d"
msgstr "Spalte links von Platz %d einfügen"

#. translators: %d: seat number
#: src/Ui/SeatingEditor.php:182
#, php-format
msgid "Delete column %d"
msgstr "Spalte %d löschen"

#. translators: %d: seat number
#: src/Ui/SeatingEditor.php:192
#, php-format
msgid "Add a column right of seat %d"
msgstr "Spalte rechts von Platz %d einfügen"

#. translators: %s: row letter
#: src/Ui/SeatingEditor.php:212
#, php-format
msgid "Add a row behind row %s"
msgstr "Reihe hinter Reihe %s einfügen"

#. translators: %s: row letter
#: src/Ui/SeatingEditor.php:219
#, php-format
msgid "Delete row %s"
msgstr "Reihe %s löschen"

#. translators: %s: row letter
#: src/Ui/SeatingEditor.php:224
#, php-format
msgid "Add a row in front of row %s"
msgstr "Reihe vor Reihe %s einfügen"

#: src/Ui/SeatingEditor.php:268
msgid "Swipe or scroll sideways to see all seats."
msgstr "Wische oder scrolle zur Seite, um alle Plätze zu sehen."

#. translators: %s: e.g. "Delete row C"
#: src/Ui/SeatingEditor.php:306
#, php-format
msgid "%s? The people on it will not be seated."
msgstr "%s? Die Personen darauf haben dann keinen Platz mehr."

#. translators: 1: name, 2: piece title
#: src/Ui/SeatingEditor.php:397
#, php-format
msgid "Voice of %1$s in %2$s"
msgstr "Stimme von %1$s in %2$s"

#. translators: %s: name
#: src/Ui/SeatingEditor.php:429
#, php-format
msgid "Seat of %s"
msgstr "Platz von %s"

#. translators: 1: row letter, A at the front, 2: seat number, counted from the left
#: src/Ui/SeatingEditor.php:437
#, php-format
msgid "Row %1$s, seat %2$d"
msgstr "Reihe %1$s, Platz %2$d"

#: src/Ui/SeatingTab.php:96
msgid "The seating has not been finished yet."
msgstr "Sitzplan noch nicht abgeschlossen"

#: src/Ui/SeatingTab.php:128
msgid "Add pieces to the program to show the voices."
msgstr "Füge dem Programm Stücke hinzu, um die Stimmen anzuzeigen."

#. translators: 1: piece title, 2: its position in the program, 3: number of pieces
#: src/Ui/SeatingTab.php:137
#, php-format
msgid "Voices in %1$s (%2$d of %3$d)"
msgstr "Stimmen in %1$s (%2$d von %3$d)"

#: src/Ui/SeatingTab.php:153
msgid "Previous piece"
msgstr "Vorheriges Stück"

#: src/Ui/SeatingTab.php:156
msgid "Next piece"
msgstr "Nächstes Stück"

#: src/Ui/SeatingTab.php:168
msgid "Download PDF"
msgstr "PDF herunterladen"

#: src/Ui/SeatingTab.php:188
msgid "Seat organizers"
msgstr "Organisatoren setzen"

#: src/Ui/SeatingTab.php:201
msgid "Nobody has accepted yet. Everyone who registers can be seated here."
msgstr ""
"Noch niemand hat sich angemeldet. Alle, die sich anmelden, können hier "
"gesetzt werden."

#: src/Ui/SeatingTab.php:213
msgid "Edit master seating"
msgstr "Stammsitzplan bearbeiten"

#: src/Ui/SeatingTab.php:222
msgid ""
"Replace the current seating with the master seating? Everyone keeps their "
"row, the rows are closed up to the left, and people who are not in the "
"master seating are not seated."
msgstr ""
"Den aktuellen Sitzplan durch den Stammsitzplan ersetzen? Alle behalten ihre "
"Reihe, die Reihen rücken nach links auf, und wer nicht im Stammsitzplan ist, "
"bekommt keinen Platz."

#: src/Ui/SeatingTab.php:225
msgid "Apply master seating"
msgstr "Stammsitzplan übernehmen"
