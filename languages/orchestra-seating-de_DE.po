#: src/Plugin.php:119
msgid ""
"Orchestra Seating requires Orchestra Core 0.7, Orchestra Projects 0.14, "
"Orchestra Library and Orchestra Members to be active."
msgstr ""
"Orchestra Seating benötigt Orchestra Core 0.7, Orchestra Projects 0.14, "
"Orchestra Library und Orchestra Members."

#: src/Privacy/PersonalData.php:38 src/Privacy/PersonalData.php:53
#: src/Privacy/PersonalData.php:74
msgid "Orchestra seating"
msgstr "Orchester-Sitzplan"

#: src/Privacy/PersonalData.php:78
msgid "Project"
msgstr "Projekt"

#: src/Privacy/PersonalData.php:81
msgid "Row"
msgstr "Reihe"

#: src/Privacy/PersonalData.php:82 src/Ui/SeatingTab.php:175
msgid "Seat"
msgstr "Platz"

#: src/Seating/SeatingInput.php:52
msgid "A seat is outside the grid."
msgstr "Ein Platz liegt außerhalb des Rasters."

#: src/Seating/SeatingInput.php:56
msgid "Two people cannot sit on the same seat."
msgstr "Zwei Personen können nicht auf demselben Platz sitzen."

#: src/Seating/SeatingInput.php:96
msgid "The grid cannot get any larger."
msgstr "Das Raster kann nicht größer werden."

#: src/Seating/SeatingInput.php:99
msgid "The grid needs a seat for everyone."
msgstr "Das Raster braucht einen Platz für alle."

#: src/Seating/SeatingInput.php:105
msgid "Only an empty last row or column can be removed."
msgstr "Nur eine leere letzte Reihe oder Spalte kann entfernt werden."

#: src/Ui/SeatingController.php:50
msgid "You are not allowed to do this."
msgstr "Das darfst du nicht."

#: src/Ui/SeatingController.php:53
msgid "The seating of a completed project cannot be changed."
msgstr ""
"Der Sitzplan eines abgeschlossenen Projekts kann nicht geändert werden."

#: src/Ui/SeatingController.php:71
msgid "The seating has been saved."
msgstr "Der Sitzplan wurde gespeichert."

#: src/Ui/SeatingTab.php:55
msgid "Seating"
msgstr "Sitzplan"

#. translators: %s: piece title
#: src/Ui/SeatingTab.php:84
#, php-format
msgid "Voices in %s"
msgstr "Stimmen in %s"

#: src/Ui/SeatingTab.php:129
msgid "Add pieces to the program to show the voices."
msgstr "Füge dem Programm Stücke hinzu, um die Stimmen anzuzeigen."

#: src/Ui/SeatingTab.php:132
msgid "Voices from"
msgstr "Stimmen aus"

#: src/Ui/SeatingTab.php:146
msgid "Seat organizers"
msgstr "Organisatoren setzen"

#. translators: 1: number of seated people, 2: number of people to seat
#: src/Ui/SeatingTab.php:149
#, php-format
msgid "%1$d of %2$d people seated. Conductors are not seated."
msgstr ""
"%1$d von %2$d Personen haben einen Platz. Dirigenten bekommen keinen Platz."

#: src/Ui/SeatingTab.php:155 src/Ui/SeatingTab.php:235
msgid "Not seated"
msgstr "Ohne Platz"

#: src/Ui/SeatingTab.php:160
msgid ""
"Drag people onto the seats or back here. Dropping on a taken seat swaps the "
"two. With the keyboard: Enter picks a person up, the arrow keys choose a "
"seat, Enter places them, Delete unseats them."
msgstr ""
"Ziehe Personen auf die Plätze oder hierher zurück. Auf einem besetzten Platz "
"tauschen die beiden. Mit der Tastatur: Enter nimmt eine Person auf, die "
"Pfeiltasten wählen einen Platz, Enter setzt sie, Entf nimmt ihr den Platz."

#: src/Ui/SeatingTab.php:167
msgid "+ Row"
msgstr "+ Reihe"

#: src/Ui/SeatingTab.php:168
msgid "+ Column"
msgstr "+ Spalte"

#: src/Ui/SeatingTab.php:169
msgid "− Row"
msgstr "− Reihe"

#: src/Ui/SeatingTab.php:170
msgid "− Column"
msgstr "− Spalte"

#: src/Ui/SeatingTab.php:175
msgid "Person"
msgstr "Person"

#: src/Ui/SeatingTab.php:181
msgid "Nobody has accepted yet."
msgstr "Noch niemand hat zugesagt."

#: src/Ui/SeatingTab.php:185
msgid "Save seating"
msgstr "Sitzplan speichern"

#: src/Ui/SeatingTab.php:188
msgid "Remove everyone from their seats?"
msgstr "Alle von ihren Plätzen nehmen?"

#: src/Ui/SeatingTab.php:189
msgid "Clear seating"
msgstr "Sitzplan leeren"

#: src/Ui/SeatingTab.php:218
msgid "Conductor"
msgstr "Dirigent"

#. translators: %s: name
#: src/Ui/SeatingTab.php:248
#, php-format
msgid "Seat of %s"
msgstr "Platz von %s"

#. translators: 1: row number, counted from the front, 2: seat number, counted from the left
#: src/Ui/SeatingTab.php:256
#, php-format
msgid "Row %1$d, seat %2$d"
msgstr "Reihe %1$d, Platz %2$d"
